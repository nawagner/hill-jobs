# Daily ingestion cron (Railway service: ingest-cron).
# Same code as the API image, plus Chromium for the Playwright-based CSOD adapter.
# Pinned to bookworm because `playwright install --with-deps` only supports
# specific Debian releases.
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN uv run --no-sync playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY app/ app/
COPY scripts/ scripts/

# scripts/ is not a package; make `import app...` resolve from /app.
ENV PYTHONPATH=/app

CMD ["uv", "run", "--no-sync", "python", "scripts/cron_ingest.py"]
